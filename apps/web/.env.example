NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=https://your-vercel-domain.vercel.app

# Instance mode: "shared" (default, multi-tenant) or "dedicated" (single tenant)
# INSTANCE_MODE=shared

# Dedicated instance only: fixed organization UUID (bypasses session-based org resolution)
# FIXED_ORG_ID=

# Optional: activates OpenAI embeddings (vector search)
OPENAI_API_KEY=

# Optional: activates LLM chat via Claude
ANTHROPIC_API_KEY=

# ── Dev-only Test-Login (/api/dev/test-login) ──────────────────────────────
# Nur lokal in apps/web/.env.local setzen — NIE in Vercel-Production und nie
# ins Repo. Ohne diese Werte antwortet der Endpoint mit 503 und die e2e-Specs
# schlagen mit einer klaren Meldung fehl statt auf ein bekanntes Passwort
# zurückzufallen.
TEST_LOGIN_CLAUDE_TESTER_EMAIL=
TEST_LOGIN_CLAUDE_TESTER_PASSWORD=
TEST_LOGIN_MAX_EMAIL=
TEST_LOGIN_MAX_PASSWORD=
TEST_LOGIN_ANNA_EMAIL=
TEST_LOGIN_ANNA_PASSWORD=

# Passwort für die per scripts/ops/create-sandbox-org.mjs angelegten
# Kunden-Sandbox-Tester.
SANDBOX_TESTER_PASSWORD=
