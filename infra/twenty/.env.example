# Twenty CRM — VPS environment. Copy to .env next to docker-compose.yml.
# Generate secrets with: openssl rand -base64 32

# Pinned Twenty release (see docs/crm-twenty.md "Update" before changing)
TAG=v2.27.0

# Public hostname (no scheme) — used by Caddy for TLS
CRM_DOMAIN=crm.example.com

# Public URL (must match CRM_DOMAIN, with https://)
SERVER_URL=https://crm.example.com

# Postgres password (internal only, never exposed)
PG_DATABASE_PASSWORD=

# 32+ byte random secrets
ENCRYPTION_KEY=
APP_SECRET=

# Invitation mail via SMTP (Resend). Leave EMAIL_DRIVER empty to disable.
EMAIL_DRIVER=smtp
EMAIL_FROM_ADDRESS=crm@app.haiway-consulting.com
EMAIL_FROM_NAME=hAIway CRM
EMAIL_SMTP_HOST=smtp.resend.com
EMAIL_SMTP_PORT=465
EMAIL_SMTP_USER=resend
EMAIL_SMTP_PASSWORD=
